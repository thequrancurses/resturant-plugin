msgstr "مشاركة موقعي لعروض القريبين"

# Seed data
msgid "Grill Hub Loyalty Card"
msgstr "كارت ولاء جريل هب"
msgid "Collect stamps with every visit. Complete the card and get your reward!"
msgstr "اجمع الأختام مع كل زيارة. أكمل الكارت واحصل على مكافأتك!"
msgid "Free meal"
msgstr "وجبة مجانية"
msgid "Show this reward code at the counter to claim it."
msgstr "اعرض كود المكافأة على الكاشير لاستلامها."
msgid "Birthday dessert"
msgstr "حلو عيد الميلاد"

# Default templates
msgid "Hi {name}! You earned a stamp at {store}. Progress: {stamps}/{required} on \"{program}\"."
msgstr "أهلاً {name}! حصلت على ختم في {store}. تقدمك: {stamps}/{required} في \"{program}\"."
msgid "Congratulations {name}! You completed \"{program}\" — your reward: {reward}. Code: {code}"
msgstr "مبروك {name}! أكملت \"{program}\" — مكافأتك: {reward}. الكود: {code}"
msgid "Hi {name}, your reward \"{reward}\" (code {code}) expires soon. Come claim it at {store}!"
msgstr "أهلاً {name}، مكافأتك \"{reward}\" (كود {code}) ستنتهي قريباً. تعال استلمها في {store}!"
msgid "Update to \"{program}\": {change}"
msgstr "تحديث في \"{program}\": {change}"
msgid "You are near {store}! Pass by today — your loyalty card is waiting for another stamp."
msgstr "أنت قريب من {store}! مرّ علينا اليوم — كارت الولاء بتاعك مستني ختم جديد."
msgid "Welcome {name}! Your loyalty card is ready. Save your personal link to collect stamps."
msgstr "أهلاً بيك {name}! كارت الولاء بتاعك جاهز. احفظ الرابط الخاص بيك عشان تجمع الأختام."
msgid "Happy birthday {name}! A gift is waiting for you at {store}: {reward}. Code: {code}"
msgstr "كل سنة وانت طيب {name}! هدية مستنياك في {store}: {reward}. الكود: {code}"
msgid "Thanks {name}! Your friend joined with your link — you earned a bonus stamp on \"{program}\"."
msgstr "شكراً {name}! صديقك انضم بالرابط بتاعك — كسبت ختم إضافي في \"{program}\"."

