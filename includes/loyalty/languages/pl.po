msgstr "Jak skonfigurować Portfel Google (jednorazowo, za darmo)"
msgid "Registered Apple devices"
msgstr "Zarejestrowane urządzenia Apple"
msgid "No devices yet."
msgstr "Brak urządzeń."
msgid "Could not read the .p12 file. Wrong password?"
msgstr "Nie udało się odczytać pliku .p12. Błędne hasło?"
msgid "The .p12 file has no certificate/key."
msgstr "Plik .p12 nie zawiera certyfikatu/klucza."
msgid "Could not extract the private key."
msgstr "Nie udało się wyodrębnić klucza prywatnego."
msgid "This certificate is expired."
msgstr "Ten certyfikat wygasł."
msgid "Could not read the WWDR file."
msgstr "Nie udało się odczytać pliku WWDR."
msgid "Invalid WWDR certificate file."
msgstr "Nieprawidłowy plik certyfikatu WWDR."
msgid "Invalid service account JSON."
msgstr "Nieprawidłowy plik JSON konta usługi."
msgid "Add to Apple Wallet"
msgstr "Dodaj do Apple Wallet"
msgid "Add to Google Wallet"
msgstr "Dodaj do Portfela Google"
msgid "Save to phone wallet"
msgstr "Zapisz w portfelu telefonu"
msgid "Your stamps update automatically in the wallet."
msgstr "Twoje pieczątki aktualizują się automatycznie w portfelu."

msgid "Paste the service account JSON here…"
msgstr "Wklej tutaj zawartość pliku JSON konta usługi…"
msgid "Open the .json key file in any text editor, copy everything and paste it here."
msgstr "Otwórz plik klucza JSON w dowolnym edytorze tekstu, skopiuj całą zawartość i wklej tutaj."
msgid "Paste new JSON only to replace it."
msgstr "Wklej nowy JSON tylko w celu zastąpienia."

msgid "Could not create the wallet folder. Check the uploads folder permissions."
msgstr "Nie udało się utworzyć folderu portfela. Sprawdź uprawnienia folderu uploads."
msgid "Could not write the file. Check the uploads folder permissions."
msgstr "Nie udało się zapisać pliku. Sprawdź uprawnienia folderu uploads."

msgid "Form expired. Please reload the page and try again."
msgstr "Formularz wygasł. Odśwież stronę i spróbuj ponownie."

msgid "Alternative (if pasting is blocked): upload the file as google-sa.json via FTP / File Manager to wp-content/uploads/ls-wallet/ — it will be detected automatically on reload."
msgstr "Alternatywa (jeśli wklejanie jest zablokowane): prześlij plik jako google-sa.json przez FTP / menedżer plików do wp-content/uploads/ls-wallet/ — zostanie wykryty automatycznie po odświeżeniu."

msgid "Saving…"
msgstr "Zapisywanie…"
msgid "Network error: the request was blocked before reaching WordPress."
msgstr "Błąd sieci: żądanie zostało zablokowane przed dotarciem do WordPressa."
msgid "Permission denied."
msgstr "Brak uprawnień."

msgid "Nothing was received. Please paste the JSON again."
msgstr "Nic nie dotarło. Wklej JSON ponownie."
msgid "The pasted text is not valid JSON. Please copy the full contents of the downloaded .json key file."
msgstr "Wklejony tekst nie jest prawidłowym JSON. Skopiuj całą zawartość pobranego pliku klucza .json."
msgid "This JSON is not a service account key (missing \"%s\"). In Google Cloud Console go to IAM & Admin → Service Accounts → your account → Keys → Add key → Create new key → JSON, then paste the downloaded file."
msgstr "Ten JSON nie jest kluczem konta usługi (brakuje \"%s\"). W Google Cloud Console przejdź do IAM i administracja → Konta usługi → Twoje konto → Klucze → Dodaj klucz → Utwórz nowy klucz → JSON, a następnie wklej pobrany plik."
msgid "This JSON is not a service account key (\"type\" must be \"service_account\")."
msgstr "Ten JSON nie jest kluczem konta usługi (\"type\" musi mieć wartość \"service_account\")."

msgid "Upload the downloaded .json key file directly (easiest)."
msgstr "Prześlij pobrany plik klucza .json bezpośrednio (najłatwiej)."
msgid "Or paste its contents below:"
msgstr "Lub wklej jego zawartość poniżej:"

msgid "Scan"
msgstr "Skanuj"
msgid "QR scanning is not supported on this device or browser. Please enter the phone number manually."
msgstr "Skanowanie QR nie jest obsługiwane na tym urządzeniu lub w tej przeglądarce. Wpisz numer telefonu ręcznie."
msgid "Could not access the camera"
msgstr "Nie można uzyskać dostępu do kamery"
msgid "Point the camera at the customer's QR code"
msgstr "Skieruj kamerę na kod QR klienta"
msgid "Close"
msgstr "Zamknij"

msgid "A stamp was already added to this card recently. Next stamp in about %d minutes."
msgstr "Niedawno dodano pieczątkę do tej karty. Następna pieczątka za około %d min."
msgid "A stamp was already added to this card recently. Next stamp in about %d hours."
msgstr "Niedawno dodano pieczątkę do tej karty. Następna pieczątka za około %d godz."
msgid "Hours between stamps on the same card (0 = no limit)"
msgstr "Godziny między pieczątkami na tej samej karcie (0 = bez limitu)"

msgid "Customer phone (optional)"
msgstr "Telefon klienta (opcjonalnie)"
msgid "Leave the phone empty for a sample pass. Send the downloaded file to an iPhone (e.g. via AirDrop or email) to preview the pass."
msgstr "Zostaw telefon pusty, aby pobrać przykładową kartę. Wyślij pobrany plik na iPhone'a (np. przez AirDrop lub e-mail), aby zobaczyć kartę."
msgid "Sample Customer"
msgstr "Przykładowy klient"
msgid "Loyalty Program"
msgstr "Program lojalnościowy"
msgid "Free reward"
msgstr "Darmowa nagroda"
