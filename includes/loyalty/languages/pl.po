# Seed data
msgid "Grill Hub Loyalty Card"
msgstr "Karta lojalnościowa Grill Hub"
msgid "Collect stamps with every visit. Complete the card and get your reward!"
msgstr "Zbieraj pieczątki przy każdej wizycie. Uzupełnij kartę i odbierz nagrodę!"
msgid "Free meal"
msgstr "Darmowy posiłek"
msgid "Show this reward code at the counter to claim it."
msgstr "Pokaż ten kod przy kasie, aby odebrać nagrodę."
msgid "Birthday dessert"
msgstr "Deser urodzinowy"

# Default templates
msgid "Hi {name}! You earned a stamp at {store}. Progress: {stamps}/{required} on \"{program}\"."
msgstr "Cześć {name}! Zdobyłeś pieczątkę w {store}. Postęp: {stamps}/{required} w programie „{program}”."
msgid "Congratulations {name}! You completed \"{program}\" — your reward: {reward}. Code: {code}"
msgstr "Gratulacje {name}! Ukończyłeś program „{program}” — Twoja nagroda: {reward}. Kod: {code}"
msgid "Hi {name}, your reward \"{reward}\" (code {code}) expires soon. Come claim it at {store}!"
msgstr "Cześć {name}, Twoja nagroda „{reward}” (kod {code}) wkrótce wygasa. Przyjdź odebrać ją w {store}!"
msgid "Update to \"{program}\": {change}"
msgstr "Aktualizacja programu „{program}”: {change}"
msgid "You are near {store}! Pass by today — your loyalty card is waiting for another stamp."
msgstr "Jesteś blisko {store}! Wpadnij dziś — Twoja karta lojalnościowa czeka na kolejną pieczątkę."
msgid "Welcome {name}! Your loyalty card is ready. Save your personal link to collect stamps."
msgstr "Witaj {name}! Twoja karta lojalnościowa jest gotowa. Zapisz swój osobisty link, aby zbierać pieczątki."
msgid "Happy birthday {name}! A gift is waiting for you at {store}: {reward}. Code: {code}"
msgstr "Wszystkiego najlepszego {name}! Prezent czeka na Ciebie w {store}: {reward}. Kod: {code}"
msgid "Thanks {name}! Your friend joined with your link — you earned a bonus stamp on \"{program}\"."
msgstr "Dzięki {name}! Twój znajomy dołączył z Twojego linku — zdobyłeś dodatkową pieczątkę w programie „{program}”."

